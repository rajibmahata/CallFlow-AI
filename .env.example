# ==========================================
# CallFlow-AI  — Environment Variables
# ==========================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# ------------------------------------------
# APP
# ------------------------------------------
APP_ENV=development               # development | production
APP_SECRET_KEY=change-me-32-chars-minimum
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=callflow
POSTGRES_USER=callflow
POSTGRES_PASSWORD=callflow_secret
DATABASE_URL=postgresql+asyncpg://callflow:callflow_secret@db:5432/callflow

# ------------------------------------------
# REDIS
# ------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------
# LLM PROVIDERS
# ------------------------------------------
# Default provider used when campaign.llm_provider is not set
DEFAULT_LLM_PROVIDER=openai       # openai | deepseek

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------
# RETELL AI (Voice calling)
# ------------------------------------------
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
RETELL_WEBHOOK_SECRET=whsec_...   # HMAC secret for webhook validation
RETELL_FROM_NUMBER=+1XXXXXXXXXX   # Twilio number registered in Retell

# ------------------------------------------
# TWILIO (SMS + Phone)
# ------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_SMS_WEBHOOK_URL=https://yourdomain.com/webhook/sms

# ------------------------------------------
# ELEVENLABS (Voice synthesis — used in Retell agent config)
# ------------------------------------------
ELEVENLABS_API_KEY=el_...
ELEVENLABS_VOICE_ID=voice_...     # Recommended: warm, slow-paced voice

# ------------------------------------------
# CHROMADB (RAG knowledge base)
# ------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_COLLECTION=event_knowledge

# ------------------------------------------
# JWT AUTH
# ------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------
# COMPLIANCE
# ------------------------------------------
# Calling hours enforced in local time (24h format)
CALL_WINDOW_START=9              # 9 AM
CALL_WINDOW_END=21               # 9 PM
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------
# CELERY
# ------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------
# MONITORING
# ------------------------------------------
SENTRY_DSN=                       # Leave blank to disable Sentry
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
